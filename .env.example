# Copia este archivo a .env.local (no se versiona) y completa los valores.

# Cadena de conexión PostgreSQL.
# - Neon: Dashboard > Connect > rama "dev".
#   postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
# - Local con `npm run db:local`:
#   postgresql://postgres:local@127.0.0.1:5433/postgres
DATABASE_URL=

# Better Auth: URL pública exacta de la aplicación y secreto aleatorio largo.
# En producción reemplaza la URL por el dominio HTTPS del despliegue.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
